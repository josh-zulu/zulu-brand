# Copy this file to .env and paste your own keys. .env is gitignored and Claude is denied read access to it.

# fal.ai: image + video generation (https://fal.ai/dashboard/keys)
FAL_KEY=

# ElevenLabs: voice, sound effects, music, transcription, and the live dictation slide
# (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Optional: default voice for voiceover (find IDs in the ElevenLabs Voice Library)
ELEVENLABS_VOICE_ID=

# Anthropic: turns the dictated ramble into a structured brief on slide 7
# (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Codex CLI image generation uses your ChatGPT sign-in, not a key. Run once:  codex login
